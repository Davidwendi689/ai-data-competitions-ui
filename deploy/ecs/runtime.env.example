# Web has no DB, AUTH_SECRET or storage provider credentials.
ECS_PORT=13000
API_ORIGIN=http://127.0.0.1:13001
WEB_TRUSTED_ORIGIN=https://ai-data-competitions.cn
API_SERVICE_TOKEN=REPLACE_WITH_MATCHING_64_HEX_TOKEN
WEB_RELEASE_MODE=trusted
# Enable only after the ingress overwrites this header with exactly one validated client IP.
WEB_CLIENT_IP_HEADER=x-forwarded-for
SEARCH_REGEX_ENABLED=false
