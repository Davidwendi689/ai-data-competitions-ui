# Exactly the seven Web environment fields. No backend management credentials.
API_SERVICE_TOKEN=REPLACE_WITH_MATCHING_64_HEX_TOKEN
API_ORIGIN=http://127.0.0.1:13001
WEB_TRUSTED_ORIGIN=https://ai-data-competitions.cn
WEB_CLIENT_IP_HEADER=x-real-ip
WEB_RELEASE_MODE=trusted
ECS_PORT=13000
NODE_ENV=production
# NODE_OPTIONS and BFF_UPLOAD_TIMEOUT_SECONDS=1260 are unit settings, not file overrides.
